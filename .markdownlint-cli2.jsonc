// markdownlint-cli2 configuration — drives the CI workflow
// (.github/workflows/markdown-lint.yml).
{
  "globs": ["**/*.md", "!node_modules", "!.git", "!graft"],
  "config": {
    // MD013 – line length: impractical for tables and URLs in docs.
    "MD013": false,

    // MD041 – first-line heading: PR summaries and fragments use ## Summary.
    "MD041": false,

    // MD024 – duplicate headings: CHANGELOG.md repeats "### Added" etc. under
    // each release (Keep a Changelog), so only flag duplicate siblings.
    "MD024": { "siblings_only": true }
  }
}
